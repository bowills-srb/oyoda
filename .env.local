# ============================================================================
# Oyvoda — LOCAL DEVELOPMENT environment  (.env.local)
# ============================================================================
# V1.0 prototype: the app runs FULLY LOCAL against Postgres with seeded mock
# data. No Twilio, no Escapia, no Railway, no external API keys are required
# to boot or to serve the operator queue / activity feed.
#
# SAFE TO COMMIT: this file contains only local-dev stubs and a throwaway
# local database password — NO real secrets. Put real credentials in `.env`
# (gitignored), which OVERRIDES the values here.
#
# Loaded automatically by:
#   - the FastAPI app    (app/core/config.py)
#   - Alembic migrations (db/migrations/env.py)
# ============================================================================

# ── Runtime ──────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ── Database (local PostgreSQL) ───────────────────────────────────────────────
# App runtime uses the async asyncpg driver. Local Postgres has SSL off, so no
# sslmode is appended here (asyncpg connects in plaintext by default).
DATABASE_URL=postgresql+asyncpg://oyvoda:oyvoda@localhost:5432/oyvoda
# Alembic uses the sync psycopg2 driver. The migration URL resolver appends
# `sslmode=require` unless one is already present, so we pin sslmode=disable
# for local Postgres.
ALEMBIC_DATABASE_URL=postgresql://oyvoda:oyvoda@localhost:5432/oyvoda?sslmode=disable
PREFER_LOCAL_DATABASE=false
AUTO_FALLBACK_LOCAL_DATABASE=false

# ── Startup checks — relaxed for local dev ────────────────────────────────────
STRICT_STARTUP_CHECKS=false
ENABLE_CONCIERGE_HEALTH_CHECKS=false
RUN_EMBEDDED_BACKGROUND_WORKERS=false
RUN_GMAIL_POLLING_WORKER=false

# ── Redis — OPTIONAL locally ──────────────────────────────────────────────────
# Leave unset: the guest-session manager and rate limiter fall back to a
# database / in-process implementation when REDIS_URL is not exported.
# REDIS_URL=redis://localhost:6379/0

# ── Security / encryption — LOCAL DEV values (regenerate for any real env) ─────
SECRET_KEY=a44ced3a5893e8131c195ea3146d7a16f3e286d8a5988e7297f53d9345e6172a
OYVODA_MASTER_KEY=0fvUswmD3ViXcrpmZcWhIA2hHmOAyAXG1vNMHi7Vy44=
OYVODA_MASTER_KEY_ID=v1

# ── Base URL ──────────────────────────────────────────────────────────────────
BASE_URL=http://localhost:8000

# ── LLM providers — OPTIONAL for V1 queue/feed ────────────────────────────────
# The operator queue and activity feed work without any LLM key. Add a Groq
# key only when you want the concierge to draft AI replies.
GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# ── External integrations — DISABLED for the V1.0 prototype ───────────────────
# Twilio (SMS / RCS) — not used in V1
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# Escapia PMS — not used in V1
# ESCAPIA_API_KEY=
# FIRST_OPERATOR_COMPANY_ID=
# Email / Voice — not used in V1
# SENDGRID_API_KEY=
# DEEPGRAM_API_KEY=
# ELEVENLABS_API_KEY=

# ── Operator auth — leave blank for local dev (no API key required) ───────────
# OPS_API_KEY=
