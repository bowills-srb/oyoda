# ─────────────────────────────────────────────────────────────────────────────
# Oyvoda — Environment Configuration Example
# Copy to .env and fill in your values. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── DATABASE ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://rental:rental@db:5432/rental_revenue
LOCAL_DATABASE_URL=postgresql+asyncpg://rental:rental@localhost:5433/rental_revenue
PREFER_LOCAL_DATABASE=false
AUTO_FALLBACK_LOCAL_DATABASE=true

# ── STARTUP CHECKS ────────────────────────────────────────────────────────────
REQUIRED_CONCIERGE_TABLES=concierge_guest_sessions
ENABLE_CONCIERGE_HEALTH_CHECKS=false
STRICT_STARTUP_CHECKS=false

# ── LLM PROVIDERS ─────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...
# GEMINI_API_KEY=

# ── BASE URL ──────────────────────────────────────────────────────────────────
# Local dev: http://localhost:8000
# Production: https://app.oyvoda.com
BASE_URL=http://localhost:8000

# ── OPERATOR AUTH ─────────────────────────────────────────────────────────────
# Protects /operator-dashboard. Leave blank for local dev.
# OPS_API_KEY=your-secret-key

# ── ESCAPIA PMS ───────────────────────────────────────────────────────────────
# ESCAPIA_API_KEY=esc_live_...
# FIRST_OPERATOR_COMPANY_ID=your-uuid-here

# ── MESSAGING — TWILIO ───────────────────────────────────────────────────────
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_PHONE_NUMBER=+1...
# TWILIO_MESSAGING_SID=MG...
# TWILIO_RCS_ENABLED=false
# TWILIO_VALIDATE_SIGNATURES=false

# ── EMAIL ─────────────────────────────────────────────────────────────────────
# SENDGRID_API_KEY=

# ── VOICE ─────────────────────────────────────────────────────────────────────
# DEEPGRAM_API_KEY=
# ELEVENLABS_API_KEY=
