FROM python:3.11-slim

WORKDIR /app

# Install Python dependencies. The pinned worker requirements resolve to
# wheels in production, so we skip the compiler/libpq toolchain to keep the
# Railway builder footprint small.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Set Python path
ENV PYTHONPATH=/app

# Default worker configuration
ENV WORKER_QUEUE=ingestion
ENV WORKER_CONCURRENCY=5

# Default command for platforms that don't override startCommand.
# Railway worker/beat services can override this per-service, but the image
# should still boot into a valid Celery worker by default.
CMD ["sh", "-c", "celery -A app.workers.celery_app:celery_app worker --loglevel=INFO --queues=${WORKER_QUEUE} --hostname=${WORKER_QUEUE}@%h --concurrency=${WORKER_CONCURRENCY} --prefetch-multiplier=1"]
